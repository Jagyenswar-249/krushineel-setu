# KrushiNeel Setu Environment Configuration

DEMO_MODE=true
PROJECT_NAME="KrushiNeel Setu"
VERSION="1.0.0"

# Database Configuration (SQLite default for zero-dependency local run, or PostgreSQL)
DATABASE_URL=sqlite:///./krushineel.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/setu

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=krushineel-secret-key-production-change-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ColdWatch Demo Simulator
SIMULATOR_ENABLED=true

# SMS Gateway Configuration
SMS_PROVIDER=mock            # mock | twilio | fast2sms
SMS_API_KEY=
SMS_SENDER_ID=KRUSHI

# External APIs (Optional in Demo Mode - Cached fallback bundled)
DATAGOV_API_KEY=
ML_SERVICE_URL=http://localhost:9000

# Web Push Keys (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
